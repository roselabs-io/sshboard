{{define "cert-row"}}<tr id="cert-row-{{.KeyID}}">
    <td><span class="badge {{.StatusClass}}">{{.Status}}</span></td>
    {{if .IsDeploy}}<td><code>{{.Repo}}</code></td>{{end}}
    <td><code>{{.KeyID}}</code></td>
    <td>
        {{range $i, $p := .PrincipalsList}}{{if $i}}, {{end}}<code>{{$p}}</code>{{end}}
    </td>
    <td>{{.CA}}</td>
    <td>
        {{if .HasExpiry}}<small>{{.ExpiresAt.Format "2006-01-02 15:04 UTC"}}</small>{{else}}—{{end}}
    </td>
    <td><small>{{.TimeLeft}}</small></td>
    <td>
        <form hx-get="/t/{{.Token}}/api/cert/inspect"
              hx-target="#cert-dialog">
            <input type="hidden" name="key_id" value="{{.KeyID}}">
            <input type="hidden" name="ca" value="{{.CA}}">
            <input type="hidden" name="cert" value="{{.Cert}}">
            <button type="submit" class="secondary outline small">Inspect</button>
        </form>
        {{if and (ne .Status "REVOKED") (ne .Status "NEVER")}}
        <form hx-post="/t/{{.Token}}/api/cert/revoke"
              hx-target="closest tr"
              hx-swap="outerHTML"
              hx-confirm="Revoke cert {{.KeyID}} ({{.Principals}})? This cannot be undone.">
            <input type="hidden" name="key_id" value="{{.KeyID}}">
            <input type="hidden" name="ca" value="{{.CA}}">
            <input type="hidden" name="principals" value="{{.Principals}}">
            <button type="submit" class="secondary outline small">Revoke</button>
        </form>
        {{if .PubkeyAvailable}}
        <form hx-post="/t/{{.Token}}/api/cert/renew"
              hx-target="closest tr"
              hx-swap="outerHTML"
              hx-prompt="Renew cert {{.KeyID}} ({{.Principals}})? sshca signs {{.Pubkey}} again with its default validity. Optional scp target for the new cert (empty: do not ship):">
            <input type="hidden" name="key_id" value="{{.KeyID}}">
            <input type="hidden" name="ca" value="{{.CA}}">
            <button type="submit" class="secondary outline small">Renew</button>
        </form>
        {{else}}
        <small class="muted" title="{{.Pubkey}}">Renew: pubkey file not found</small>
        {{end}}
        {{end}}
    </td>
</tr>
{{end}}
