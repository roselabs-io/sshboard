{{define "certs-content"}}
<hgroup>
    <h1>Certs</h1>
    <p>Reading <code>{{.CADir}}/issuance-log.jsonl</code>{{if .ShipTarget}} &middot; revoke also ships KRL to <code>{{.ShipTarget}}</code>{{else}} &middot; <small class="muted">no KRL ship target set; revoke updates local KRL only (start sshboard with <code>--krl-ship user@host:/etc/ssh/revoked_keys.krl</code> to push)</small>{{end}}.</p>
</hgroup>

{{if .Error}}
<article class="error">
    <strong>Error</strong>
    <p>{{.Error}}</p>
</article>
{{else if not .Total}}
<article>
    <strong>(no certs in issuance log yet)</strong>
    <p>Sign your first cert via <code>sshca cert sign --ca user --principal X --valid +8h --key-id ID --dir {{.CADir}} &lt;pubkey&gt;</code> to populate this table.</p>
</article>
{{else}}
<form method="get" action="/t/{{.Token}}/certs" class="cert-filter">
    <input type="search" name="q" value="{{.Query}}" placeholder="Filter by key_id" aria-label="Filter by key_id">
    <input type="hidden" name="status" value="{{.StatusFilter}}">
</form>
<div role="group" class="cert-filter" aria-label="Filter by status">
    {{range .FilterStatuses}}<a role="button" href="/t/{{$.Token}}/certs?status={{.}}{{if $.Query}}&amp;q={{$.Query}}{{end}}" class="small{{if ne . $.StatusFilter}} outline{{end}}" {{if eq . $.StatusFilter}}aria-current="true"{{end}}>{{.}}</a>{{end}}
</div>
<p><small class="muted">{{len .Certs}} of {{.Total}} cert(s). Sorted by expiry (most-urgent first). EXPIRING marks deploy certs that expire within {{.DeployWindow}} and the others within 24h.</small></p>
{{if not .Certs}}
<article>
    <strong>No cert matches the filter.</strong>
</article>
{{else}}
{{if .DeployCerts}}
<section id="certs-deploy">
    <h2>CI deploy</h2>
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>STATUS</th>
                    <th>REPOSITORY</th>
                    <th>KEY_ID</th>
                    <th>PRINCIPALS</th>
                    <th>CA</th>
                    <th>EXPIRES_AT</th>
                    <th>TIME_LEFT</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{range .DeployCerts}}{{template "cert-row" .}}{{end}}
            </tbody>
        </table>
    </div>
</section>
{{end}}
{{if .OtherCerts}}
<section id="certs-other">
    {{if .DeployCerts}}<h2>Other certificates</h2>{{end}}
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>STATUS</th>
                    <th>KEY_ID</th>
                    <th>PRINCIPALS</th>
                    <th>CA</th>
                    <th>EXPIRES_AT</th>
                    <th>TIME_LEFT</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{range .OtherCerts}}{{template "cert-row" .}}{{end}}
            </tbody>
        </table>
    </div>
</section>
{{end}}
<div id="cert-dialog"></div>
{{end}}
{{end}}

<script>
    // HTMX confirms for destructive actions; this is a marker that we're using
    // hx-confirm on the row template's revoke button.
</script>
{{end}}
